# Copy to .env.local. Values from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server only. Never expose to the browser. Used for onboarding customers.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Transactional email for welcome credentials (Resend free tier: 3k/month).
RESEND_API_KEY=<resend-key>
EMAIL_FROM="Portal <noreply@yourdomain.com>"

# Used in welcome emails to link to the login page.
NEXT_PUBLIC_APP_URL=http://localhost:3000
